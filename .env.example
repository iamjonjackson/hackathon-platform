# Neon Postgres (pooled connection string from the Vercel/Neon marketplace integration)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Neon direct (unpooled) connection string - used for applying schema.sql / migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Shared admin password for logging in at /admin/login
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session JWT (generate with: openssl rand -base64 32)
JWT_SECRET="change-me"

# Optional: leaderboard auto-refresh interval in milliseconds (default 30000)
LEADERBOARD_REFRESH_MS=30000
